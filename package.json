{
  "name": "blind-view",
  "version": "0.1.0",
  "private": true,
  "description": "Blind View — hear what the camera sees. An assistive live audio-description app.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace @blind-view/server",
    "dev:web": "npm run dev --workspace @blind-view/web",
    "build": "npm run build --workspace @blind-view/web",
    "preview": "npm run preview --workspace @blind-view/web",
    "start": "npm run start --workspace @blind-view/server",
    "test": "npm test --workspaces --if-present",
    "deploy:api": "gcloud run deploy blind-view-api --source . --region asia-south1 --service-account blind-view-api@blind-view-ai.iam.gserviceaccount.com --min-instances 0 --max-instances 3 --memory 512Mi --timeout 3600 --allow-unauthenticated --set-env-vars \"^@^GOOGLE_CLOUD_PROJECT=blind-view-ai@VERTEX_LOCATION=global@GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite@SCENE_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite@LIVE_LOCATION=us-central1@REQUIRE_APP_CHECK=true@ALLOWED_ORIGINS=https://blind-view-ai.web.app,https://blind-view-ai.firebaseapp.com\"",
    "deploy:api:preview": "npm run deploy:api -- --no-traffic --tag preview",
    "deploy:web": "npm run build && firebase deploy --only hosting --project blind-view-ai",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
