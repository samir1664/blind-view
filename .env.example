# ─────────────────────────────────────────────────────────────
# Blind View — environment configuration
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
#
# NOTE: These keys are read ONLY by the server (apps/server).
# They are never bundled into the browser. Do not prefix any
# secret with VITE_ — anything with that prefix is public.
# ─────────────────────────────────────────────────────────────

# ── REQUIRED (one of the two) ───────────────────────────────
# Option A — Vertex AI on Google Cloud (recommended; used in production).
# Covered by Cloud credits, no daily cap, no key: auth comes from
#   gcloud auth application-default login   (on your machine)
#   the Cloud Run service account           (in production)
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=global
# Force a provider: vertex | aistudio. Defaults to vertex when a project is set.
# GEMINI_PROVIDER=

# ── Firebase (App Check + anonymous auth) ───────────────────
# Leave blank to run locally without Firebase. The web config is public by
# design; it identifies the project and grants nothing.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_RECAPTCHA_SITE_KEY=
# Dev-only App Check debug token. Register it in Firebase console → App Check.
VITE_APPCHECK_DEBUG_TOKEN=
# Server: require App Check + ID tokens on paid endpoints (true in production).
REQUIRE_APP_CHECK=false

# Option B — Google AI Studio key (zero-setup local fallback).
# Get one free at: https://aistudio.google.com/apikey
#
# Put the real value in `.env`, never here. This file is committed to git;
# `.env` is not.
GEMINI_API_KEY=

# ── OPTIONAL ────────────────────────────────────────────────
# Models to try, in order, separated by commas. A model that is retired (404)
# or out of quota (429) is skipped and the next one tried.
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Port for the local API proxy server.
PORT=8787

# Comma-separated list of origins allowed to call the proxy.
# Leave as-is for local development.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Requests allowed per IP per minute (protects your API quota/bill).
RATE_LIMIT_PER_MIN=60

# Max accepted image upload size in kilobytes.
MAX_IMAGE_KB=2048
